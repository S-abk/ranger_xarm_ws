# Upstream sources this workspace builds against.
#   vcs import --recursive src < ranger_xarm.repos
# --recursive matters: xarm_sdk carries a git submodule, and without it the
# first build fails on "xarm_sdk contains sub-modules".
#
# Pinned to the commit this workspace was verified on. Bump deliberately:
# xarm_ros2 supplies xarm_description, xarm_msgs, xarm_sdk, xarm_api and
# xarm_controller, and the arm mount height and joint limits here are matched
# to it.
#
# TEMPORARILY pointed at a fork. 8d01a1b is upstream jazzy (3dc2b5e, which
# this was previously pinned to) plus one commit declaring the gripper's five
# follower joints to ros2_control with mimic="true". Without it the gripper
# linkage comes apart in simulation, because this sim runs on dartsim and
# dartsim has no mimic constraint support (gazebosim/gz-physics#432).
#
# That commit is upstream as xArm-Developer/xarm_ros2#180. When it merges,
# point the url back at xArm-Developer and pin the merged commit; nothing
# else here needs to change. The fork exists only so a fresh clone works
# today rather than whenever the PR lands.
repositories:
  xarm_ros2:
    type: git
    url: https://github.com/S-abk/xarm_ros2.git
    version: 8d01a1ba12fa18eb352b085fcb1d36a26e14723f
  # Needed only by ranger_xarm_isaac: the ros2_control hardware interface
  # that talks to a simulator over topics, which is what lets MoveIt and the
  # existing joint_trajectory_controllers drive Isaac unchanged. Released as
  # ros-jazzy-joint-state-topic-hardware-interface, so `rosdep install` can
  # supply it instead and this entry can be dropped; it is pinned here so
  # the workspace builds without needing apt. Only its
  # joint_state_topic_hardware_interface package is used.
  #
  # Pinned to the 1.1.0 release, the one Jazzy's apt package is built from,
  # not to main: main adds joint_command_topic_hardware_interface, which
  # needs a control_msgs newer than Jazzy's (control_msgs/msg/JointCommand),
  # so a plain `colcon build` fails on it and aborts everything else.
  # joint_state_topic_hardware_interface is identical in the two apart from
  # its README.
  topic_based_hardware_interfaces:
    type: git
    url: https://github.com/ros-controls/topic_based_hardware_interfaces.git
    version: d30e9ab8c9990893a93b28dc24e6cdf73fa770c4  # 1.1.0
  # KISS-ICP lidar odometry, fused into the EKF by ranger_xarm_bringup's
  # ekf_odom_imu.launch.py (lidar_odometry:=true). Built from source because
  # the Jazzy binary is not available from this machine's apt sources and
  # rosdep has no rule for it. v1.3.0 is the release that added Jazzy.
  kiss-icp:
    type: git
    url: https://github.com/PRBonn/kiss-icp.git
    version: b16835283aee62f7d5e2bdf6c1c3bb2930de74ff
