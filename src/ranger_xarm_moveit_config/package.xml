  <version>0.7.0</version>
  <description>MoveIt 2 Jazzy planning configuration for the Ranger Mini V3 + xArm6 combined robot.</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ranger_xarm_description</exec_depend>
  <exec_depend>xarm_description</exec_depend>
  <exec_depend>xarm_controller</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_core</exec_depend>
