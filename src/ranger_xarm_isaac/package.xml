<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>ranger_xarm_isaac</name>
  <version>0.1.0</version>
  <description>
    Isaac Sim bring-up for the Ranger Mini + xArm 6 platform: the same URDF
    the real robot and the gz simulation use, converted to USD as a build
    artifact. Nothing in this package is needed to run the physical robot,
    and nothing in it is a second description of the robot.
  </description>
  <maintainer email="solanrewaju2020@fau.edu">Ranger xArm maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ranger_xarm_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- control.launch.py: reuses xarm's controller yaml rewriter and its
       config, drives Isaac through the topic-based hardware interface, and
       runs the base through ranger_xarm_gazebo's 4WIS controller, wheel
       odometry and base controller config. -->
  <exec_depend>uf_ros_lib</exec_depend>
  <exec_depend>xarm_controller</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_topic_hardware_interface</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- moveit.launch.py: planning config is reused from the moveit package;
       only the controller map is local. -->
  <exec_depend>ranger_xarm_moveit_config</exec_depend>
  <exec_depend>ranger_xarm_gazebo</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Isaac Sim itself is deliberately not a dependency. It is installed
       out of tree and runs under its own interpreter, so
       rosdep cannot resolve it and colcon must not try. urdf_to_usd.py is
       run with Isaac Sim's own interpreter ($ISAACSIM_PYTHON_EXE), not the system python. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
