<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Simulated sensors for gz.

       The description carries the sensor links, meshes and CAD-derived
       mount poses, but carried no <sensor> tags, so gz rendered them and
       nothing more. This adds the sensors the platform actually has: Ouster OS0 and its
       IMU, RPLIDAR A1M8, the gantry D455 and the wrist D435.

       Topics and frame ids match what the REAL drivers publish, because
       ranger_xarm_sensors already defines that contract and everything
       downstream is written against it. The Isaac side publishes the same
       set, so the two simulators are interchangeable behind it.

       The sensor-internal frames (os_lidar, os_imu, the optical frames)
       are deliberately NOT links here. On hardware they belong to the
       drivers, which publish them from the sensor's own metadata and
       calibration; that split is why the *_mount_link frames exist in this
       description and nothing below them does. Putting them in the URDF
       would collide with the driver's own transforms the moment a real
       sensor is plugged in. gz names them with <gz_frame_id> and
       sim.launch.py publishes the transforms, which is what the driver
       does.

       Specs are datasheet figures, not guesses, and where gz cannot
       express something it is called out rather than quietly rounded. -->

  <xacro:macro name="ranger_gazebo_sensors"
               params="ouster:=true rplidar:=true gantry_d455:=true wrist_d435:=false imu:=true">

    <!-- Ouster OS0. 90 deg vertical FOV (+/-45) is what makes it an OS0
         rather than an OS1 or OS2. 128 channels at 1024 azimuth steps and
         10 Hz matches the profile the Isaac side uses, so a bag from one
         has the same shape as a bag from the other. Range is the real
         0.3-50 m; note Isaac's shipped OS0 profile says 0.5-75, so the two
         simulators disagree at the extremes and the datasheet is right. -->
    <xacro:if value="${ouster}">
      <gazebo reference="os_sensor">
        <sensor name="ouster_os0" type="gpu_lidar">
          <!-- OS-series: the lidar origin sits 36.18 mm above the sensor
               origin and is yawed 180 deg. Family defaults; a specific
               unit's values come from its own metadata JSON. -->
          <pose>0 0 0.03618 0 0 ${pi}</pose>
          <!-- Deliberately 'ouster', not 'ouster/points'. A gz
               gpu_lidar publishes a LaserScan on <topic> and the point
               cloud on <topic>/points, so naming this 'ouster/points'
               puts the cloud on 'ouster/points/points' and leaves a
               flattened single-ring scan on the name you wanted. -->
          <topic>ouster</topic>
          <gz_frame_id>os_lidar</gz_frame_id>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>1024</samples>
                <resolution>1</resolution>
                <min_angle>${-pi}</min_angle>
                <max_angle>${pi}</max_angle>
              </horizontal>
              <vertical>
                <samples>128</samples>
                <resolution>1</resolution>
                <min_angle>${-pi/4}</min_angle>
                <max_angle>${pi/4}</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.3</min>
              <max>50.0</max>
              <resolution>0.001</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
        </sensor>
      </gazebo>
    </xacro:if>

    <!-- The OS0's built-in IMU. It is inside the lidar, not a separate
         device, which is why it hangs off os_sensor rather than a mount
         of its own. gz reports gravity on a stationary accelerometer, as
         the real one does, so nothing extra is needed to avoid an
         attitude filter downstream reading free fall. -->
    <xacro:if value="${imu}">
      <gazebo reference="os_sensor">
        <sensor name="ouster_imu" type="imu">
          <topic>ouster/imu</topic>
          <gz_frame_id>os_imu</gz_frame_id>
          <update_rate>100</update_rate>
          <always_on>1</always_on>
        </sensor>
      </gazebo>
    </xacro:if>

    <!-- RPLIDAR A1M8. Datasheet: 0.15-12 m, 5.5 Hz typical, 8000
         samples/s, which is 1454 points per revolution. Unlike Isaac's
         RTX lidar, whose scan rate attribute is integral and forced 6 Hz,
         gz takes the 5.5 directly, so this one is the sensor's actual
         default. -->
    <xacro:if value="${rplidar}">
      <gazebo reference="laser_frame">
        <sensor name="rplidar_a1m8" type="gpu_lidar">
          <pose>0 0 0 0 0 0</pose>
          <topic>scan</topic>
          <gz_frame_id>laser_frame</gz_frame_id>
          <update_rate>5.5</update_rate>
          <always_on>1</always_on>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>1454</samples>
                <resolution>1</resolution>
                <min_angle>${-pi}</min_angle>
                <max_angle>${pi}</max_angle>
              </horizontal>
              <!-- One plane. This is what makes it a 2D scanner, and it
                   is the thing Isaac's RTX lidar silently got wrong when
                   an unknown config name fell back to a 32-beam fan. -->
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.15</min>
              <max>12.0</max>
              <resolution>0.013</resolution>
            </range>
          </lidar>
        </sensor>
      </gazebo>
    </xacro:if>

    <!-- The two RealSense cameras. gz's rgbd_camera publishes colour, depth,
         a point cloud and camera_info off one sensor, which carries the same
         simplification the Isaac side has: colour and depth share an imager,
         so they are perfectly registered and share the colour's FOV. On
         hardware the depth pair is wider and sits a baseline away with its
         own intrinsics.

         Frame semantics. <name>_link is the REP-103 camera_link (X forward,
         Z up), so the sensor <pose> is identity and the camera looks along
         the link's +X. gz-sim's rgbd_camera looks along the sensor frame's
         +X too, so no extra rotation is needed here; the optical-frame
         rotation exists only in the static transforms the sims publish
         (<name>_link -> <name>_{color,depth}_optical_frame), and gz_frame_id
         just names the frame in the message header. Both links are
         massless fixed children (gantry_d455_link of gantry_d455_mount_link,
         wrist_d435_link of wrist_d435_mount_link). sdformat's URDF parser
         lumps those into the parent link and re-poses every sensor by the
         lumped fixed-joint transform. Checked with `gz sdf -p` on the
         expanded model: gantry_d455 ends up on base_footprint (the lumped
         root) at (-0.319, 0, 1.390) with the lens along +X; wrist_d435 ends
         up on xarm_link6 (xarm_link_eef is itself lumped into it) at
         (0.075, 0, 0.025) with the lens along link6's +Z, the tool axis, so
         it moves with joint 6. -->

    <!-- Intel RealSense D455 on the gantry. Colour FOV H90 x V65 (D400
         datasheet rev 021). The image stays 848x480 like the D435, which
         gz turns into V58.6 rather than 65: gz derives the vertical FOV
         from HFOV and the aspect ratio, and the datasheet 65 deg belongs to
         the 16:10 1280x800 mode. Near clip 0.18 m is the D455 minimum-Z at
         424x240 (D435: 0.105), the same convention. Far clip stays at 10 m
         as in the rest of this file: the D455 is rated further, but the
         far clip only bounds what gz renders and 10 m covers the indoor
         workspace; raise it if you need longer depth. -->
    <xacro:if value="${gantry_d455}">
      <gazebo reference="gantry_d455_link">
        <sensor name="gantry_d455" type="rgbd_camera">
          <pose>0 0 0 0 0 0</pose>
          <topic>camera/gantry_d455</topic>
          <gz_frame_id>gantry_d455_color_optical_frame</gz_frame_id>
          <update_rate>30</update_rate>
          <always_on>1</always_on>
          <camera>
            <horizontal_fov>${90.0*pi/180.0}</horizontal_fov>
            <image>
              <width>848</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.18</near>
              <far>10.0</far>
            </clip>
            <optical_frame_id>gantry_d455_color_optical_frame</optical_frame_id>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

    <!-- Intel RealSense D435 on the xArm wrist. Colour FOV H69 x V42, near
         0.105 m (D435 minimum-Z at 424x240). The wrist links exist only
         when the xArm and its gripper are in the model, so the caller
         passes wrist_d435 accordingly (see ranger_xarm.urdf.xacro). -->
    <xacro:if value="${wrist_d435}">
      <gazebo reference="wrist_d435_link">
        <sensor name="wrist_d435" type="rgbd_camera">
          <pose>0 0 0 0 0 0</pose>
          <topic>camera/wrist_d435</topic>
          <gz_frame_id>wrist_d435_color_optical_frame</gz_frame_id>
          <update_rate>30</update_rate>
          <always_on>1</always_on>
          <camera>
            <horizontal_fov>${69.0*pi/180.0}</horizontal_fov>
            <image>
              <width>848</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.105</near>
              <far>10.0</far>
            </clip>
            <optical_frame_id>wrist_d435_color_optical_frame</optical_frame_id>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
