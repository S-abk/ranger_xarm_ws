<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- suspension: whether ranger_wheels.xacro models the suspension links;
       it matters only with wheels_modelled, for how the base's mass is split. -->
  <xacro:macro name="ranger_static_geometry" params="parent:='base_link' use_collision:=true wheels_modelled:=false suspension:=true">
    <link name="ranger_cad_link">
      <!-- Chassis mass, from the base's user manual: 75 kg with its wheels,
           centre of gravity 0.214 m above the floor and 14.9 mm to one side
           (the right, as read from the manual's drawing). Without modelled
           wheels this link carries the whole base; with them it carries
           what the wheel, knuckle and suspension links do not, so the base
           has the same mass, centre and inertia either way. The values are
           generated from config/mass_properties.yaml. A massless platform
           drives badly in physics: gz falls back to a ~1 kg placeholder,
           and a massless wheel has no normal force and so no traction. -->
      <xacro:ranger_cad_inertial wheels="${wheels_modelled}" suspension="${suspension}"/>
      <!-- Which CAD to draw depends on whether the wheels are their own
           links. ranger_mini_v3_cad.stl is the whole vehicle with its
           wheels moulded in at zero steer, which is right when nothing
           else draws them. Once ranger_wheels.xacro provides real wheel
           links, those moulded wheels are welded to base_link and sit on
           top of the ones that actually turn, so the robot drives while
           appearing completely static. The body mesh is the same CAD with
           the four wheels cut out; see scripts/split_wheel_meshes.py. -->
      <xacro:if value="${wheels_modelled}">
        <visual name="ranger_cad_visual">
          <geometry>
            <mesh filename="package://ranger_xarm_description/meshes/visual/ranger_mini_v3_cad_body.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="ranger_cad_material"><color rgba="0.72 0.72 0.68 1"/></material>
        </visual>
      </xacro:if>
      <xacro:unless value="${wheels_modelled}">
        <visual name="ranger_cad_visual">
          <geometry>
            <mesh filename="package://ranger_xarm_description/meshes/visual/ranger_mini_v3_cad.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="ranger_cad_material"><color rgba="0.72 0.72 0.68 1"/></material>
        </visual>
      </xacro:unless>
      <xacro:if value="${use_collision}">
        <!-- ranger_envelope is the whole-vehicle bounding box, wheels
             included, so its underside sits at base_link z=-0.3819: 5.5 cm
             BELOW the wheel tread at -0.3270. With no wheel collisions that
             is merely conservative, and the platform rests on the box.
             Once ranger_wheels.xacro provides real tyre collisions it is
             actively wrong; the box grounds out first and holds the wheels
             in the air, where they spin freely and the robot cannot drive.
             So when wheels are modelled the envelope is cut back to the
             chassis proper, whose underside measures -0.2514 in the CAD
             mesh (76 mm ground clearance, matching the published spec). -->
        <xacro:if value="${wheels_modelled}">
          <collision name="ranger_envelope">
            <origin xyz="-0.001000 0 -0.116180" rpy="0 0 0"/>
            <geometry><xacro:structure_box size="0.803706 0.500020 0.270360"/></geometry>
          </collision>
        </xacro:if>
        <xacro:unless value="${wheels_modelled}">
          <collision name="ranger_envelope">
            <origin xyz="-0.001000 0 -0.181436" rpy="0 0 0"/>
            <geometry><xacro:structure_box size="0.803706 0.500020 0.400891"/></geometry>
          </collision>
        </xacro:unless>
      </xacro:if>
    </link>
    <joint name="base_to_ranger_cad" type="fixed">
      <parent link="${parent}"/><child link="ranger_cad_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="custom_structure_link">
      <!-- Arm pedestal, gantry, battery pack, power mount, the arm's control
           box, laptop stand and laptop, lidars and fasteners: 44.5 kg from a
           parts list (CAD volumes times materials, labels and datasheets;
           not weighed), centre 0.63 m above the floor and 0.18 m aft of
           base_link, less the gantry camera's own inertial. The values are
           generated from config/mass_properties.yaml. -->
      <xacro:custom_structure_inertial/>
      <visual name="custom_structure_visual">
        <geometry>
          <mesh filename="package://ranger_xarm_description/meshes/visual/custom_structure_cad.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="custom_structure_material"><color rgba="0.34 0.34 0.34 1"/></material>
      </visual>
      <!-- 140 mm PETG gantry camera/Ouster support (Cam_3d_lidar_mount_2,
           2026-10-30 CAD): exact mesh tessellated from the project's private
           CAD (linear deflection 0.05 mm), holes included, closed and
           manifold, in mm in this link's (= base_link) frame. The old 110 mm
           bracket was removed from custom_structure_cad.stl so the two do not
           share faces. Visual only; the collision below stays the
           conservative solid box. See the package README (Meshes). -->
      <visual name="gantry_support_140_visual">
        <geometry><mesh filename="package://ranger_xarm_description/meshes/visual/gantry_support_140.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="petg_material"><color rgba="0.85 0.45 0.10 1"/></material>
      </visual>
      <xacro:if value="${use_collision}">
        <collision name="sensor_mount_collision"><origin xyz="0.265 0 0.015"/><geometry><xacro:structure_box size="0.125 0.270 0.024"/></geometry></collision>
        <collision name="ac_control_box_collision"><origin xyz="-0.266466 -0.000618 0.293431"/><geometry><xacro:structure_box size="0.128615 0.307250 0.143363"/></geometry></collision>
        <collision name="arm_pedestal_collision"><origin xyz="0 0 0.198763"/><geometry><xacro:structure_box size="0.292100 0.292100 0.359525"/></geometry></collision>
        <collision name="ecoflow_collision"><origin xyz="-0.288706 0 0.126315"/><geometry><xacro:structure_box size="0.259080 0.269240 0.195580"/></geometry></collision>
        <collision name="power_mount_collision"><origin xyz="-0.295625 0 0.003636"/><geometry><xacro:structure_box size="0.298750 0.509834 0.129273"/></geometry></collision>
        <collision name="gantry_right_upright_collision"><origin xyz="-0.395 -0.220001 0.573525"/><geometry><xacro:structure_box size="0.080 0.040001 1.100"/></geometry></collision>
        <collision name="gantry_crossbar_collision"><origin xyz="-0.395 0 1.103524"/><geometry><xacro:structure_box size="0.080 0.400 0.040001"/></geometry></collision>
        <collision name="gantry_left_upright_collision"><origin xyz="-0.395 0.220001 0.573525"/><geometry><xacro:structure_box size="0.080 0.040001 1.100"/></geometry></collision>
        <collision name="arm_mount_plate_collision"><origin xyz="0 0 0.384875"/><geometry><xacro:structure_box size="0.2032 0.2032 0.0127"/></geometry></collision>
        <collision name="laptop_stand_collision"><origin xyz="-0.255915 0 0.306025"/><geometry><xacro:structure_box size="0.351830 0.400 0.165"/></geometry></collision>
        <!-- PETG gantry camera/Ouster support, widened from 110 to 140 mm for the
             D455 (Cam_3d_lidar_mount_2:1, 2026-10-30 CAD). Only y changed. -->
        <collision name="camera_lidar_mount_collision"><origin xyz="-0.3375 0 1.086025"/><geometry><xacro:structure_box size="0.035 0.140 0.075"/></geometry></collision>
      </xacro:if>
    </link>
    <joint name="base_to_custom_structure" type="fixed">
      <parent link="${parent}"/><child link="custom_structure_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
