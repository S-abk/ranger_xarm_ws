<?xml version="1.0"?>
<!-- GENERATED by scripts/make_mass_properties.py from config/mass_properties.yaml.
     Do not edit: change the data file and run the script; the package test fails if
     this file is not what the data gives. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ranger_cad_link. wheels / suspension: as passed to ranger_static_geometry. -->
  <xacro:macro name="ranger_cad_inertial" params="wheels suspension">
    <xacro:unless value="${wheels}">
      <inertial>
        <!-- the whole base, corners included: 75.0 kg (base user manual: total weight including wheels); base centre y: 0.0149 m to the right, base user manual, centre-of-gravity drawing; the side is read from the drawing; one measurement on the robot did not confirm it -->
        <origin xyz="0 -0.0149 -0.113029" rpy="0 0 0"/>
        <mass value="75"/>
        <inertia ixx="2.460871" ixy="0" ixz="0" iyy="4.84748" iyz="0.036351" izz="6.003532"/>
      </inertial>
    </xacro:unless>
    <xacro:if value="${wheels}">
      <xacro:unless value="${suspension}">
        <inertial>
          <!-- the base less its wheels and knuckles; base centre y: 0.0149 m to the right, base user manual, centre-of-gravity drawing; the side is read from the drawing; one measurement on the robot did not confirm it -->
          <origin xyz="0 -0.018941 -0.083479" rpy="0 0 0"/>
          <mass value="59"/>
          <inertia ixx="1.623962" ixy="0" ixz="0" iyy="3.562605" iyz="0.00333" izz="4.431166"/>
        </inertial>
      </xacro:unless>
      <xacro:if value="${suspension}">
        <inertial>
          <!-- the base less its wheels, knuckles and suspension links; base centre y: 0.0149 m to the right, base user manual, centre-of-gravity drawing; the side is read from the drawing; one measurement on the robot did not confirm it -->
          <origin xyz="0 -0.019334 -0.0805" rpy="0 0 0"/>
          <mass value="57.8"/>
          <inertia ixx="1.556335" ixy="0" ixz="0" iyy="3.463366" iyz="0" izz="4.315557"/>
        </inertial>
      </xacro:if>
    </xacro:if>
  </xacro:macro>

  <!-- custom_structure_link: the structure parts less what other links carry. -->
  <xacro:macro name="custom_structure_inertial" params="">
    <inertial>
      <!-- structure parts (config/mass_properties.yaml), less gantry_d455_mount_link -->
      <origin xyz="-0.184361 0 0.303815" rpy="0 0 0"/>
      <mass value="44.414"/>
      <inertia ixx="4.637582" ixy="0" ixz="1.116797" iyy="5.456575" iyz="0" izz="1.983814"/>
    </inertial>
  </xacro:macro>

  <!-- Wheel corners (ranger_wheels.xacro). -->
  <xacro:property name="mp_wheel_mass" value="3.0"/>
  <xacro:property name="mp_knuckle_mass" value="1.0"/>
  <xacro:property name="mp_knuckle_com_z" value="0.02"/>
  <xacro:property name="mp_knuckle_ixx" value="0.0015"/>
  <xacro:property name="mp_knuckle_iyy" value="0.0015"/>
  <xacro:property name="mp_knuckle_izz" value="0.002"/>
  <xacro:property name="mp_suspension_link_mass" value="0.3"/>
  <xacro:property name="mp_suspension_link_ixx" value="0.0002"/>
  <xacro:property name="mp_suspension_link_iyy" value="0.0002"/>
  <xacro:property name="mp_suspension_link_izz" value="0.0002"/>
  <!-- Suspension rest settings per axle: springReference = -setting. -->
  <xacro:property name="mp_suspension_rest_front" value="0.0123"/>
  <xacro:property name="mp_suspension_rest_rear" value="0.0204"/>
</robot>
