<?xml version="1.0" ?>
<!-- A ground plane and a sun, nothing else.

     Deliberately empty: this workspace is the platform, not any one
     application. Put your own world in your own package and pass it with
     world:=/absolute/path.sdf rather than adding scenery here. -->
<!-- The outdoor terrain, inside an 11 x 10 m walled room with a row of 4 round pillars, so lidar odometry has structure to match against. Generated by scripts/make_surface_worlds.py. -->
<sdf version="1.9">
  <world name="empty_ground">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- The IMU is a separate system from Sensors. Sensors covers the
         rendering ones (cameras, gpu_lidar); an <sensor type="imu"> is
         simply never updated without this, and nothing complains: the
         topic just does not appear. -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <!-- Floor friction lives here rather than on the wheels, because
               URDF has nowhere to put it: neither <gazebo reference> mu1/mu2
               nor a <surface> block inside <collision> survives the URDF to
               SDF conversion (check with gz sdf -p; the converted wheel
               collision comes out with no <surface> at all). Setting it on
               the plane is native SDF and always applies, and gz combines
               the two surfaces anyway.

               torsional 0 is the load-bearing line. Torsional friction
               resists a wheel twisting about the contact normal, and with
               four loaded wheels it summed into a yaw resistance the drive
               could not overcome: a commanded spin produced under 10% of
               its yaw while the wheel joints turned at exactly the right
               speed. Real tyres do have some, but gz's patch-radius model
               grossly overstates it for a 100 kg platform. -->
          <surface>
            <friction>
              <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
              <torsional><coefficient>0.0</coefficient></torsional>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  
    <model name="outdoor_terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><mesh><uri>model://ranger_xarm_gazebo/models/outdoor_terrain/terrain.glb</uri></mesh></geometry>
          <surface>
            <friction>
              <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
              <torsional><coefficient>0.0</coefficient></torsional>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>model://ranger_xarm_gazebo/models/outdoor_terrain/terrain.glb</uri></mesh></geometry>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>1.500 -4.000 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>11.2 0.2 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>11.2 0.2 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>1.500 6.000 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>11.2 0.2 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>11.2 0.2 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4.000 1.000 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.2 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10.2 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>7.000 1.000 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.2 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10.2 2.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_1">
      <static>true</static>
      <pose>-2.000 4.600 0.500 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.35 0.5 1</ambient><diffuse>0.25 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>0.000 4.600 0.500 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.35 0.5 1</ambient><diffuse>0.25 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_3">
      <static>true</static>
      <pose>2.000 4.600 0.500 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.35 0.5 1</ambient><diffuse>0.25 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_4">
      <static>true</static>
      <pose>4.000 4.600 0.500 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.6</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.35 0.5 1</ambient><diffuse>0.25 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
