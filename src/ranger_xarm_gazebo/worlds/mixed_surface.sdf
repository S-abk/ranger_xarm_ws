<?xml version="1.0" ?>
<!-- A ground plane and a sun, nothing else.

     Deliberately empty: this workspace is the platform, not any one
     application. Put your own world in your own package and pass it with
     world:=/absolute/path.sdf rather than adding scenery here. -->
<!-- 31 low-grip patches (mu 0.15) on a normal floor, in a checker so wheels on the same axle can be on different surfaces. This is the case that produces heading error. Generated by scripts/make_surface_worlds.py. -->
<sdf version="1.9">
  <world name="empty_ground">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- The IMU is a separate system from Sensors. Sensors covers the
         rendering ones (cameras, gpu_lidar); an <sensor type="imu"> is
         simply never updated without this, and nothing complains: the
         topic just does not appear. -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <!-- Floor friction lives here rather than on the wheels, because
               URDF has nowhere to put it: neither <gazebo reference> mu1/mu2
               nor a <surface> block inside <collision> survives the URDF to
               SDF conversion (check with gz sdf -p; the converted wheel
               collision comes out with no <surface> at all). Setting it on
               the plane is native SDF and always applies, and gz combines
               the two surfaces anyway.

               torsional 0 is the load-bearing line. Torsional friction
               resists a wheel twisting about the contact normal, and with
               four loaded wheels it summed into a yaw resistance the drive
               could not overcome: a commanded spin produced under 10% of
               its yaw while the wheel joints turned at exactly the right
               speed. Real tyres do have some, but gz's patch-radius model
               grossly overstates it for a 100 kg platform. -->
          <surface>
            <friction>
              <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
              <torsional><coefficient>0.0</coefficient></torsional>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  
    <model name="patch_1">
      <static>true</static>
      <pose>-2.400 -2.400 0.004 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.1 1.1 0.008</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.15</mu><mu2>0.15</mu2></ode>
              <torsional><coefficient>0.0</coefficient></torsional>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.1 1.1 0.008</size></box></geometry>
          <material>
            <ambient>0.65 0.3 0.35 1</ambient>
            <diffuse>0.70 0.35 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="patch_2">
      <static>true</static>
      <pose>-2.400 0.000 0.004 0 0 0</pose>
